@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{var token=Antiforgery.GetAndStoreTokens(Context);var title=ViewData["Title"]?.ToString()??"A graceful point of view.";var description=ViewData["Description"]?.ToString()??"Discover Zahr Boutique. Explore the boutique collection, save your favourite pieces and enquire directly with Zahr Boutique in Lebanon.";}
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@title · Zahr Boutique</title><meta name="description" content="@description"/>
<meta name="theme-color" content="#f4e9e4"/><meta name="csrf-token" content="@token.RequestToken"/>
<meta property="og:title" content="@title · Zahr Boutique"/><meta property="og:description" content="@description"/>
<meta property="og:type" content="website"/><meta property="og:image" content="@(Context.Request.Scheme+"://"+Context.Request.Host+(ViewData["Image"]??Shop.Settings.Hero))"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="preload" href="/fonts/serif.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/motion.css" asp-append-version="true"/><script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/experience.js" asp-append-version="true" defer></script><script src="~/js/motion.js" asp-append-version="true" defer></script><script src="~/vendor/lenis.min.js" asp-append-version="true" defer></script><script src="~/js/motion-plus.js" asp-append-version="true" defer></script>
</head><body data-brand="zahr-boutique" data-skin="soft" data-photo-fit="portrait" data-shop-name="Zahr Boutique" data-shop-phone="@Shop.Settings.Phone" data-contact-url="@Shop.Settings.ContactUrl()" data-contact-mode="@Shop.Settings.ContactMode" data-page="@ViewData["Page"]">
<div class="scroll-progress" aria-hidden="true"></div><a class="skip" href="#main">Skip to content</a>
<div class="announcement"><span>FASHION · LEBANON</span><a href="/contact">Discover Zahr Boutique in Lebanon <span aria-hidden="true">↗</span></a></div>
<header class="header" data-header><a class="wordmark" href="/" aria-label="Zahr Boutique home">ZAHR<span>FASHION · LEBANON</span></a>
<nav id="navigation" aria-label="Main navigation"><a href="/shop">Shop the edit</a><a href="/our-world">Our story</a><a href="/lookbook">Visual diary</a><a href="/contact">Visit & contact</a></nav>
<div class="header-actions"><button type="button" data-open="search-dialog" aria-label="Search pieces"><partial name="_Icon" model='@("search")'/></button><a href="/saved" aria-label="Saved pieces"><partial name="_Icon" model='@("heart")'/><span class="counter" data-saved-count hidden>0</span></a><button type="button" data-open="bag-dialog" aria-label="Open shopping bag"><partial name="_Icon" model='@("bag")'/><span class="counter" data-bag-count hidden>0</span></button><button class="menu-button" type="button" aria-label="Menu" aria-controls="navigation" aria-expanded="false"><partial name="_Icon" model='@("menu")'/></button></div>
</header>
<main id="main">@RenderBody()</main>
<section class="closing"><span class="eyebrow">A LITTLE GUIDANCE GOES A LONG WAY</span><h2>Your next favourite<br/>starts with <em>a conversation.</em></h2><a class="button light" href="/contact">Talk to the boutique <span>↗</span></a></section>
<footer><div class="footer-brand"><a class="wordmark" href="/">ZAHR<span>FASHION · LEBANON</span></a><p>A graceful point of view.</p><a href="@Shop.Settings.Instagram" target="_blank" rel="noopener noreferrer">Follow our world on Instagram ↗</a></div><div><h3>EXPLORE</h3><a href="/shop">All pieces</a><a href="/our-world">Our story</a><a href="/style-guide">Find your edit</a><a href="/saved">Your favourites</a></div><div><h3>LET’S CONNECT</h3><a href="@Shop.Settings.ContactUrl()" target="_blank" rel="noopener noreferrer">@(Shop.Settings.UsesWhatsApp?"WhatsApp · "+Shop.Settings.DisplayPhone:"Instagram enquiries") ↗</a><a href="/contact">Visit & contact</a><span>Contact the boutique for opening hours</span><a href="/privacy">Privacy & ordering</a></div><div class="footer-bottom"><span>© @DateTime.UtcNow.Year Zahr Boutique</span><span>Independent storefront preview by WebBloom.</span><a href="#main">Back to top ↑</a></div></footer>
<dialog id="search-dialog" class="search-dialog" aria-label="Search pieces"><div class="dialog-heading"><h2>What speaks to you?</h2><button data-close type="button" aria-label="Close search"><partial name="_Icon" model='@("close")'/></button></div><form action="/shop" method="get" class="search-form"><label for="global-search">Search by piece or category</label><div><input id="global-search" autofocus name="q" type="search" placeholder="Find a piece or a category…" maxlength="100"/><button type="submit" aria-label="Submit search"><partial name="_Icon" model='@("arrow")'/></button></div></form><div class="search-suggestions" data-search-suggestions aria-live="polite"></div><p class="eyebrow">START EXPLORING</p><a href="/shop">All pieces ↗</a>@foreach(var c in Shop.Products.Select(p=>p.Collection).Distinct().Take(3)){<a href="/shop?collection=@Uri.EscapeDataString(c)">@c ↗</a>}<a href="/style-guide">Help me choose ↗</a></dialog>
<dialog id="bag-dialog" class="bag-dialog" aria-label="Shopping bag"><div class="dialog-heading"><h2>Your bag <span data-bag-count>0</span></h2><button data-close type="button" aria-label="Close shopping bag"><partial name="_Icon" model='@("close")'/></button></div><div data-cart-items></div><div class="bag-summary" data-cart-summary></div><a class="button full" href="/checkout" data-checkout-link>Review & request order <span>↗</span></a><p class="fine">Availability, delivery and final prices are confirmed by Zahr Boutique directly with the team.</p><a class="text-link" href="/shop">Continue exploring</a></dialog>
<div class="toast" role="status" aria-live="polite" hidden></div>
<button class="to-top" type="button" data-to-top aria-label="Back to top" hidden><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg></button>
<a class="whatsapp-float" href="@Shop.Settings.ContactUrl("Hello "+Shop.Settings.Brand+"! I’d love some help choosing a piece.")" target="_blank" rel="noopener noreferrer" aria-label="Contact Zahr Boutique">@(Shop.Settings.UsesWhatsApp?"A little help? WhatsApp":"A question? Instagram") ↗</a></body></html>
