@page "/product/{id}"
@{var p=Shop.Find(RouteData.Values["id"]?.ToString()??"");if(p is null){Response.StatusCode=404;ViewData["Title"]="Piece not found";}else{ViewData["Title"]=p.Name;ViewData["Image"]=p.Images[0];}ViewData["Page"]="product";}
@if(p is null){<section class="empty-state"><h1>A different direction.</h1><p>We couldn’t find that piece.</p><a class="button" href="/shop">Explore the collection ↗</a></section>}else{
<div class="product-breadcrumb"><a href="/">Home</a><span>/</span><a href="/shop">Pieces</a><span>/</span><span>@p.Name</span></div>
<section class="product-detail" data-detail="@p.Id"><div class="product-gallery"><button type="button" class="main-photo" data-open-photo aria-label="Enlarge @p.Name photograph"><img id="detail-photo" src="@p.Images[0]" alt="@p.Name by Zahr Boutique" width="1080" height="1440"/><span><partial name="_Icon" model='@("expand")'/></span></button>@if(p.Images.Length>1){<div class="thumbnails">@foreach(var (image,i) in p.Images.Select((x,i)=>(x,i))){<button type="button" data-photo="@image" class="@(i==0?"active":"")" aria-label="View photograph @(i+1)" aria-pressed="@(i==0?"true":"false")"><img src="@image" alt="@p.Name view @(i+1)" width="90" height="120" loading="lazy" decoding="async"/></button>}</div>}</div>
<div class="detail-copy"><a class="eyebrow" href="/shop?collection=@Uri.EscapeDataString(p.Collection)">@p.Collection</a><h1>@p.Name</h1><div class="detail-price"><span>@p.PriceLabel</span><span>@(Shop.ShowAudience?p.Audience:p.Collection)@if(!string.IsNullOrEmpty(p.Family)){<text> · @p.Family</text>}</span></div><p class="detail-description">@p.Description</p>
@if(p.Notes.Length>0){<div class="notes"><span class="eyebrow">THE DETAILS</span><div>@foreach(var note in p.Notes){<span>@note</span>}</div></div>}
<form class="add-form" data-add-form data-product-id="@p.Id">@if(Catalog.IsPlaceholderOption(p)){<input type="hidden" name="size" value="@p.Sizes[0]"/><p class="option-note"><partial name="_Icon" model='@("bag")'/> Size, colour and options are confirmed with you on WhatsApp.</p>}else{<fieldset><legend>Choose an option</legend>@foreach(var (size,i) in p.Sizes.Select((x,i)=>(x,i))){<label class="size-option"><input name="size" type="radio" value="@size" checked="@(i==0)"/><span>@size</span></label>}</fieldset>}<div class="purchase-row"><div class="quantity"><button type="button" data-quantity-step="-1" aria-label="Decrease quantity">−</button><label class="sr-only" for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" min="1" max="10" value="1" inputmode="numeric"/><button type="button" data-quantity-step="1" aria-label="Increase quantity">+</button></div><button type="submit" class="button" disabled>Add to bag <span>↗</span></button></div><div class="detail-links"><button type="button" class="detail-save text-link" disabled data-save="@p.Id" aria-label="Save @p.Name" aria-pressed="false"><partial name="_Icon" model='@("heart")'/> Save to your favourites</button><a class="detail-ask text-link" href="https://wa.me/@(Shop.Settings.Phone)?text=@Uri.EscapeDataString("Hello "+Shop.Settings.Brand+"! I’d like to ask about "+p.Name+" ("+HttpContext.Request.Scheme+"://"+HttpContext.Request.Host+"/product/"+p.Id+").")" target="_blank" rel="noopener noreferrer">Ask about this piece on WhatsApp ↗</a><button type="button" class="detail-share text-link" data-share data-title="@p.Name">Share ↗</button></div></form>
<p class="fine">Product pricing is shown where published by Zahr Boutique. Availability and delivery fees are confirmed with the store before your order is placed.</p>
<div class="detail-accordions"><details open><summary>Your order, made personal <span>+</span></summary><p>Build your bag, share your details and send your request directly to Zahr Boutique on WhatsApp. The team confirms availability, payment options and the final total with you.</p></details><details><summary>Need a little guidance? <span>+</span></summary><p>Tell us your preferred style, size or occasion. <a href="/style-guide">Find your edit</a> or <a href="/contact">talk to Zahr Boutique</a>.</p></details><details><summary>Delivery & collection <span>+</span></summary><p>Ask Zahr Boutique about delivery to your area or visiting the boutique. Fees, timings and collection arrangements are confirmed by the store.</p></details></div></div></section>
<section class="section"><div class="section-heading"><div><span class="eyebrow">KEEP EXPLORING</span><h2>Another side <em>of you.</em></h2></div><a class="text-link" href="/shop">View all pieces ↗</a></div><div class="product-grid">@foreach(var other in Shop.Products.Where(x=>x.Id!=p.Id).Take(4)){<partial name="_Card" model="other"/>}</div></section>
<dialog class="photo-dialog" id="photo-dialog" aria-label="Piece photograph"><button type="button" data-close aria-label="Close photograph"><partial name="_Icon" model='@("close")'/></button><img src="@p.Images[0]" alt="Enlarged photograph of @p.Name"/>@if(p.Images.Length>1){<button type="button" class="photo-step prev" data-photo-step="-1" aria-label="Previous photograph">‹</button><button type="button" class="photo-step next" data-photo-step="1" aria-label="Next photograph">›</button>}</dialog>
}
