@page "/lookbook"
@{ViewData["Title"]="The visual diary";ViewData["Page"]="lookbook";var photos=Shop.Products.SelectMany(p=>p.Images.Select(image=>new GalleryPhoto(p.Name,p.Collection,image,"/product/"+p.Id))).Concat(Shop.Settings.GalleryImages.Select(image=>new GalleryPhoto("From the visual diary","More inspiration",image,"/shop"))).GroupBy(x=>x.Image).Select(g=>g.First()).ToList();}
<section class="page-intro"><a class="breadcrumb" href="/">Home / The visual diary</a><span class="eyebrow">THE ZAHR EDIT</span><h1>A closer look.<br/><em>A new possibility.</em></h1><p>A visual diary from Zahr Boutique. Explore the photographs and open any image for a closer look.</p></section>
<section class="section lookbook-section"><div class="gallery-toolbar" role="group" aria-label="Filter gallery"><button type="button" class="gallery-filter active" data-gallery-filter="" aria-pressed="true">All photographs</button>@foreach(var c in Shop.Products.Select(p=>p.Collection).Distinct()){<button type="button" class="gallery-filter" data-gallery-filter="@c" aria-pressed="false">@c</button>}</div><p class="fine" data-gallery-count aria-live="polite">@photos.Count photographs to explore</p><div class="masonry-gallery">@foreach(var (photo,i) in photos.Select((x,i)=>(x,i))){<figure class="gallery-tile" data-gallery-category="@photo.Category"><button type="button" data-gallery-photo="@photo.Image" data-gallery-title="@photo.Name" data-gallery-href="@photo.Href" aria-label="Enlarge @photo.Name photograph @(i+1)"><img src="@photo.Image" alt="@photo.Name from Zahr Boutique" loading="lazy" width="720" height="960"/><span>View photograph ↗</span></button><figcaption><a href="@photo.Href">@photo.Name <span>↗</span></a></figcaption></figure>}</div><p class="fine gallery-footnote">Photographs are from the business’s public Instagram collection. Styling, availability and individual details are confirmed directly with the team.</p></section>
<dialog id="lookbook-dialog" class="photo-dialog lookbook-dialog" aria-label="Lookbook photograph"><button type="button" data-close aria-label="Close lookbook photograph"><partial name="_Icon" model='@("close")'/></button><img src="@Shop.Settings.Hero" alt="Collection photograph"/><div class="lookbook-caption"><span data-lookbook-title></span><a data-lookbook-link href="/shop">Explore the collection ↗</a></div><button type="button" class="photo-step prev" data-gallery-step="-1" aria-label="Previous lookbook photograph">‹</button><button type="button" class="photo-step next" data-gallery-step="1" aria-label="Next lookbook photograph">›</button></dialog>
