@page "/shop"
@{ViewData["Title"]="The collection";ViewData["Page"]="shop";var q=Request.Query["q"].ToString();var collection=Request.Query["collection"].ToString();var sort=Request.Query["sort"].ToString();var visible=Shop.Search(q,collection,null,null,sort).Select(p=>p.Id).ToHashSet();}
<section class="page-intro"><a class="breadcrumb" href="/">Home / The collection</a><span class="eyebrow">THE ZAHR EDIT</span><h1>A world<br/><em>to make your own.</em></h1><p>Find a piece. Save a favourite. Start a conversation.</p></section>
<section class="section shop-section"><form method="get" class="filters" id="filters"><div class="shop-search"><partial name="_Icon" model='@("search")'/><label class="sr-only" for="shop-query">Search the collection</label><input type="search" id="shop-query" name="q" value="@q" placeholder="Search pieces or categories" maxlength="100"/></div><div class="filter-select"><label for="collection-filter">Category</label><select id="collection-filter" name="collection"><option value="">All categories</option>@foreach(var c in Shop.Products.Select(p=>p.Collection).Distinct()){<option value="@c" selected="@(c==collection)">@c</option>}</select></div><div class="filter-select"><label for="sort-filter">Sort by</label><select id="sort-filter" name="sort"><option value="">The boutique edit</option><option value="az" selected="@(sort=="az")">Name A–Z</option></select></div><button type="submit" class="button filter-submit">Apply</button></form><div class="results-bar"><span aria-live="polite" data-results-count>@visible.Count pieces to discover</span><a href="/shop" data-reset-filters>Reset filters ↺</a></div><div class="product-grid" id="shop-grid">@foreach(var p in Shop.Search(null,null,null,null,sort)){<div class="product-slot" hidden="@(!visible.Contains(p.Id))"><partial name="_Card" model="p"/></div>}</div><div class="empty-state" data-empty-results hidden="@(visible.Count!=0)"><span class="eyebrow">A DIFFERENT DIRECTION</span><h2>Let’s try another piece.</h2><p>No pieces match these filters. Clear a filter or ask the boutique.</p><a class="button outline" href="/shop" data-reset-filters>Explore all pieces ↗</a></div><div class="catalogue-note"><span>A VISUAL EDIT, A PERSONAL CONVERSATION</span><p>Photographs are from the boutique’s public collection. Names describe the pictured pieces; official references, prices, materials, sizes and availability are confirmed by the team.</p><a class="text-link" href="/contact">Ask about a piece ↗</a></div></section>
