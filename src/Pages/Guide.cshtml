@page "/style-guide"
@{ViewData["Title"]="Find your edit";ViewData["Page"]="style-guide";}
<section class="page-intro"><a href="/" class="breadcrumb">Home / Find your edit</a><span class="eyebrow">FOLLOW YOUR OWN DIRECTION</span><h1>Something<br/><em>more you.</em></h1><p>A starting point for your next look. Choose a category, tell us your mood and explore your edit.</p></section><section class="section finder-layout"><form data-style-finder><label for="direction">What catches your eye?</label><select id="direction" name="direction" required>@foreach(var c in Shop.Products.Select(p=>p.Collection).Distinct()){<option value="@c">@c</option>}</select><label for="occasion">What’s the occasion?</label><select id="occasion" name="occasion" required><option>Everyday style</option><option>A special occasion</option><option>A thoughtful gift</option></select><label for="preferences">Your preferences <span class="optional">optional</span></label><textarea id="preferences" name="preferences" rows="3" maxlength="300" placeholder="A colour, sizing question, or a particular look…"></textarea><button type="submit" class="button">Find my edit ↗</button></form><div class="finder-result" hidden tabindex="-1"><span class="eyebrow">A LITTLE INSPIRATION</span><h2 data-finder-title></h2><p data-finder-copy></p><a class="button" data-finder-shop>Explore this edit ↗</a><a class="text-link" data-finder-chat target="_blank" rel="noopener noreferrer">Ask the boutique ↗</a><div data-finder-draft hidden><label for="finder-message">Copy this message into your conversation</label><textarea id="finder-message" data-finder-message rows="7" readonly></textarea><button type="button" class="text-link" data-copy-finder>Copy my preferences</button></div></div></section>
