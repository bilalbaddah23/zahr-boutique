@page "/saved"
@{ViewData["Title"]="Your favourites";ViewData["Page"]="saved";}
<section class="page-intro compact"><a class="breadcrumb" href="/">Home / Your favourites</a><span class="eyebrow">A LITTLE SHORTLIST</span><h1>Keep what<br/><em>speaks to you.</em></h1><p>Your favourites stay in this browser, ready for your next visit.</p></section>
<section class="section"><noscript><p>Enable JavaScript to see the pieces saved in this browser. You can still browse <a href="/shop">the collection</a>.</p></noscript><div class="results-bar"><span data-saved-label aria-live="polite">Your saved pieces</span><button type="button" class="text-link" data-clear-saved>Clear favourites</button></div><div class="product-grid" data-saved-grid>@foreach(var p in Shop.Products){<div class="product-slot" data-saved-slot="@p.Id" hidden><partial name="_Card" model="p"/></div>}</div><div class="empty-state" data-empty-saved><span class="eyebrow">ROOM FOR A NEW FAVOURITE</span><h2>Something will catch your eye.</h2><p>Tap the heart on a piece to save it here.</p><a class="button" href="/shop">Explore the collection ↗</a></div></section>
